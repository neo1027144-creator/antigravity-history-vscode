{
  "name": "antigravity-history",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.2.6",
  "publisher": "yunfenghello",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yunfenghello/antigravity-history-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other",
    "Visualization"
  ],
  "keywords": [
    "antigravity",
    "conversation",
    "history",
    "export",
    "ai",
    "chat",
    "llm",
    "backup",
    "save",
    "markdown",
    "json",
    "local",
    "browse",
    "sync",
    "recovery",
    "knowledge-base",
    "search",
    "conversations"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aghistory.openPanel",
        "title": "%command.openPanel%",
        "icon": "$(history)",
        "category": "Antigravity History"
      },
      {
        "command": "aghistory.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)",
        "category": "Antigravity History"
      },
      {
        "command": "aghistory.export",
        "title": "%command.export%",
        "icon": "$(cloud-download)",
        "category": "Antigravity History"
      },
      {
        "command": "aghistory.exportAll",
        "title": "%command.exportAll%",
        "icon": "$(cloud-download)",
        "category": "Antigravity History"
      }
    ],
    "configuration": {
      "title": "Antigravity History",
      "properties": {
        "aghistory.language": {
          "type": "string",
          "enum": [
            "zh-CN",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.zhCN%",
            "%config.language.en%"
          ],
          "default": "zh-CN",
          "description": "%config.language%"
        },
        "aghistory.exportPath": {
          "type": "string",
          "default": "./antigravity_export",
          "description": "%config.exportPath%"
        },
        "aghistory.exportFormat": {
          "type": "string",
          "enum": [
            "md",
            "json",
            "all"
          ],
          "default": "all",
          "description": "%config.exportFormat%"
        },
        "aghistory.fieldLevel": {
          "type": "string",
          "enum": [
            "default",
            "thinking",
            "full"
          ],
          "default": "thinking",
          "description": "%config.fieldLevel%"
        },
        "aghistory.exportStrategy": {
          "type": "string",
          "enum": [
            "workspace",
            "unified"
          ],
          "default": "workspace",
          "description": "%config.exportStrategy%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "javascript-obfuscator": "^5.3.0",
    "typescript": "^5.3.0"
  }
}
